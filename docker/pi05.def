Bootstrap: docker
From: nvidia/cuda:12.4.1-base-ubuntu22.04

%arguments
    # Replicating the ARG variables from Docker
    PYTHON_VERSION=3.12

%environment
    # Configure environment variables for runtime
    export DEBIAN_FRONTEND=noninteractive
    export MUJOCO_GL=egl
    export PATH=/lerobot/.venv/bin:$PATH
    export CUDA_VISIBLE_DEVICES=0
    export TEST_TYPE=single_gpu
    export DEVICE=cuda

    # User environment paths (Apptainer maps your cluster $HOME by default,
    # but we will explicitely direct caches to a local folder if needed)
    export HOME=/home/user_lerobot
    export HF_HOME=/home/user_lerobot/.cache/huggingface
    export HF_LEROBOT_HOME=/home/user_lerobot/.cache/huggingface/lerobot
    export TORCH_HOME=/home/user_lerobot/.cache/torch
    export TRITON_CACHE_DIR=/home/user_lerobot/.cache/triton

%setup
    # This section runs on the host to copy local files into the container image
    # Equivalent to "COPY . ."
    mkdir -p ${APPTAINER_ROOTFS}/lerobot
    cp -R . ${APPTAINER_ROOTFS}/lerobot/

%post
    # Bind arguments to variables for use in this script
    PYTHON_VERSION={{ PYTHON_VERSION }}

    # FIX: Tell Ubuntu to install packages non-interactively and preset the timezone
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Etc/UTC

    # Install Python, system dependencies, and uv
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common build-essential git curl \
        libglib2.0-0 libgl1-mesa-glx libegl1-mesa \
        libusb-1.0-0-dev speech-dispatcher libgeos-dev portaudio19-dev \
        cmake pkg-config ninja-build
        
    add-apt-repository -y ppa:ubuntuhandbook1/ffmpeg8
    add-apt-repository -y ppa:deadsnakes/ppa
    
    apt-get update
    apt-get install -y --no-install-recommends \
       ffmpeg \
       python${PYTHON_VERSION} \
       python${PYTHON_VERSION}-venv \
       python${PYTHON_VERSION}-dev
       
    # Install UV and move to global path
    curl -LsSf https://astral.sh/uv/install.sh | sh
    mv /root/.local/bin/uv /usr/local/bin/uv

    # Mimic the home directory structures required by the configuration
    mkdir -p /home/user_lerobot/.cache
    
    # Navigate to app directory explicitly
    cd /lerobot

    # 1. Create the virtual environment using the global uv binary
    /usr/local/bin/uv venv --python python${PYTHON_VERSION} /lerobot/.venv

    # 2. Install LeRobot into that venv by using the global uv binary 
    #    and explicitly setting the UV_PROJECT_ENVIRONMENT variable
    export UV_PROJECT_ENVIRONMENT=/lerobot/.venv
    /usr/local/bin/uv pip install --no-cache "lerobot[pi] @ git+https://github.com/huggingface/lerobot@v0.4.4"
    
    # 3. Fix permissions using the absolute path to the venv's internal tools
    find /lerobot/.venv -name ptxas -exec chmod +x {} +

    # Cleanup package manager to shrink image size
    apt-get clean && rm -rf /var/lib/apt/lists/*

%runscript
    # Equivalent to CMD ["/bin/bash"]
    exec /bin/bash "$@"